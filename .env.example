# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (Dokploy container port is 3000)
PORT=3000

# NODE_ENV: Application environment (production / development)
NODE_ENV=production

# SIP_ENCRYPTION_KEY: 32-byte hex key used by backend to encrypt SIP account passwords (AES-256-GCM)
SIP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ASTERISK_ARI_URL: Asterisk REST Interface endpoint for PJSIP/ARI call control
ASTERISK_ARI_URL="http://asterisk:8088/ari"
ASTERISK_ARI_USER="voxpulse_ari"
ASTERISK_ARI_SECRET="change_me_in_production"
ASTERISK_STASIS_APP="voxpulse-voice-engine"
