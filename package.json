{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "main": "app.js",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build && node scripts/generateEmbeddedDist.mjs && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --define:process.env.NODE_ENV='\"production\"' --outfile=passenger-server.cjs && cp passenger-server.cjs app.js && cp passenger-server.cjs app.cjs && cp passenger-server.cjs server.js && cp -r dist/* public/ && mkdir -p tmp && touch tmp/restart.txt",
    "preview": "vite preview",
    "clean": "rm -rf dist passenger-server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sip.js": "^0.21.2",
    "vite": "^8.3.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
